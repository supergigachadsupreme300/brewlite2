\subsubsection{Phạm vi hệ thống}

\textbf{Các chức năng thuộc MVP (In-scope):}
\begin{itemize}
    \item Hiển thị danh sách đồ uống và thông tin chi tiết sản phẩm.
    \item Cho phép chọn kích cỡ, topping và thêm sản phẩm vào giỏ hàng.
    \item Cho phép tăng, giảm số lượng hoặc xóa sản phẩm trong giỏ.
    \item Đăng ký, đăng nhập và xác thực người dùng bằng JWT.
    \item Tạo đơn hàng, kiểm tra tồn kho và lưu thông tin đơn.
    \item Thanh toán thông qua Mock Payment Service.
    \item Hiển thị xác nhận đơn, lịch sử đơn hàng và trạng thái đơn.
    \item Kiểm soát các chuyển trạng thái đơn hàng hợp lệ ở backend.
\end{itemize}

\textbf{Các chức năng mở rộng (Out-of-scope hoặc Could-have):}
\begin{itemize}
    \item Tích hợp cổng thanh toán thật có phát sinh giao dịch tài chính.
    \item Ứng dụng di động native riêng cho Android/iOS.
    \item Quản lý nhân sự, ca làm việc và báo cáo doanh thu chuyên sâu.
    \item Giao hàng đến địa chỉ bên ngoài cửa hàng.
    \item Hệ thống khuyến mãi và điểm thưởng đầy đủ; mô hình domain có thể chuẩn bị để mở rộng.
    \item Giao diện riêng cho Barista để cập nhật trạng thái pha chế nếu chưa nằm trong MVP.
\end{itemize}

\subsubsection{Giả định và ràng buộc}

\begin{itemize}
    \item Hệ thống phục vụ quy trình đặt và nhận đồ uống tại cửa hàng.
    \item Dữ liệu sản phẩm, giá bán và tồn kho được quản lý trong PostgreSQL.
    \item Backend là nơi xác định giá trị thanh toán cuối cùng; frontend không được tự quyết định tổng tiền hợp lệ.
    \item Các thao tác đặt đơn và cập nhật tồn kho phải được xử lý có kiểm soát để tránh bán vượt số lượng còn lại.
    \item Thanh toán chỉ được mô phỏng, không lưu thông tin thẻ thật và không kết nối giao dịch tài chính thật.
    \item Next.js, NestJS và PostgreSQL là các công nghệ bắt buộc của đề bài.
    \item Các chức năng yêu cầu đăng nhập phải gửi JWT hợp lệ đến backend.
\end{itemize}

\subsubsection{Rủi ro ban đầu}

\begin{itemize}
    \item Nếu nhiều khách đặt cùng một sản phẩm gần như đồng thời, hệ thống có thể bán vượt tồn kho nếu không dùng transaction và cập nhật có điều kiện.
    \item Nếu client gửi lại yêu cầu thanh toán do timeout, hệ thống có thể xử lý trùng nếu thiếu cơ chế idempotency.
    \item Nếu frontend và backend không thống nhất trạng thái đơn, lịch sử đơn có thể hiển thị sai.
    \item Nếu cấu hình môi trường hoặc thông tin kết nối cơ sở dữ liệu không chính xác, hệ thống có thể không khởi động hoặc không truy cập được database.
    \item Nếu không quản lý secret đúng cách, thông tin nhạy cảm có thể bị đưa vào repository hoặc log.
\end{itemize}

