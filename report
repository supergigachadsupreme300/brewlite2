\subsubsection{Luồng chính}

\begin{enumerate}
    \item Khách hàng mở trang Checkout và xem danh sách sản phẩm, số lượng, đơn giá và tổng tiền.
    \item Khách hàng kiểm tra hoặc điều chỉnh số lượng sản phẩm.
    \item Khách hàng nhập tên người nhận, số điện thoại và chọn hình thức nhận nước: mang đi hoặc tại bàn.
    \item Khách hàng xác nhận đặt hàng.
    \item Next.js gửi yêu cầu POST /orders kèm JWT đến NestJS.
    \item NestJS xác thực JWT, kiểm tra dữ liệu nhận hàng và kiểm tra giỏ hàng không rỗng.
    \item Backend lấy giá hiện tại từ database, tính lại tổng tiền và kiểm tra tồn kho từng sản phẩm.
    \item Backend mở transaction, cập nhật tồn kho có điều kiện và tạo Order ở trạng thái PENDING cùng các OrderItem.
    \item Backend commit transaction và trả về orderId cùng tổng tiền.
    \item Khách hàng chọn phương thức thanh toán Ví hoặc Thẻ và xác nhận.
    \item Frontend gửi POST /payments với orderId, phương thức thanh toán và Idempotency-Key.
    \item NestJS kiểm tra khóa idempotency và gửi yêu cầu đến Mock Payment Service.
    \item Khi thanh toán thành công, backend cập nhật Payment thành SUCCEEDED và Order thành PAID.
    \item Frontend hiển thị mã đơn, trạng thái PAID và thông báo đặt hàng thành công.
\end{enumerate}

\subsubsection{Luồng thay thế và ngoại lệ}

\begin{itemize}
    \item \textbf{A1 -- Khách hàng chưa đăng nhập:} hệ thống chuyển đến màn hình đăng nhập. Sau khi đăng nhập thành công và nhận JWT, khách hàng quay lại quá trình Checkout. Nếu thông tin đăng nhập sai, hệ thống thông báo lỗi và không tạo đơn.
    \item \textbf{A2 -- Khách hàng thay đổi giỏ hàng:} khách hàng tăng, giảm số lượng hoặc xóa sản phẩm. Frontend tính lại tổng tiền hiển thị; backend vẫn tự tính lại giá khi nhận yêu cầu tạo đơn.
    \item \textbf{E1 -- Dữ liệu không hợp lệ:} thiếu tên người nhận, số điện thoại không hợp lệ, giỏ hàng rỗng hoặc số lượng không hợp lệ. Backend trả lỗi 400 và không tạo đơn.
    \item \textbf{E2 -- JWT không hợp lệ:} backend trả lỗi 401 và từ chối yêu cầu tạo đơn.
    \item \textbf{E3 -- Hết hàng:} thao tác cập nhật tồn kho không thành công; transaction bị rollback, không tạo đơn và không trừ kho một phần.
    \item \textbf{E4 -- Thanh toán thất bại:} Payment được ghi nhận FAILED, Order chuyển sang PAYMENT\_FAILED. Giao diện thông báo thất bại và cho phép khách hàng thử thanh toán lại.
    \item \textbf{E5 -- Client gửi lại yêu cầu thanh toán:} nếu Idempotency-Key đã được xử lý, backend trả về kết quả đã lưu thay vì tạo giao dịch mới.
    \item \textbf{E6 -- Dịch vụ thanh toán timeout:} backend phải giữ khả năng tra cứu theo Idempotency-Key để xác định kết quả trước khi gửi một yêu cầu thanh toán mới, tránh xử lý trùng.
\end{itemize}

