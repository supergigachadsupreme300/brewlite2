@startuml activity
title Sơ đồ Hoạt động (Activity Diagram) — UC-AUTH-01: Đăng ký, Đăng nhập, JWT & Quản lý trạng thái đăng nhập

|#F9F9F9|Khách hàng (Customer)|
start
note right
  Mã A1–A5, E1–E9 tham chiếu UC-AUTH-01 (Task 1.3).
  Mọi nhánh thất bại kết thúc tại stop; người dùng thử lại từ đầu luồng.
end note
:Mở ứng dụng hoặc truy cập trang cần đăng nhập (ví dụ /checkout);

|#E8F4FD|Frontend (Next.js)|
:Đọc access token từ nơi lưu trữ phía client;

if (Có token?) then (Có token)
  :Gửi GET /auth/me kèm Authorization: Bearer;

  |#EDF2F8|Backend (NestJS API)|
  :JwtAuthGuard xác minh chữ ký và thời hạn (exp);
  if (Token hợp lệ?) then (Hợp lệ)
    |#FFF9E6|Cơ sở dữ liệu (PostgreSQL)|
    :Truy vấn bảng users theo sub (id trong token);

    |Backend (NestJS API)|
    if (Người dùng còn tồn tại?) then (Còn)
      :Trả về HTTP 200 kèm id, email, fullName (không có mật khẩu, không có hash);

      |Frontend (Next.js)|
      :Khôi phục trạng thái đăng nhập [A2];
      if (Đang ở trang /login hoặc /register?) then (Đúng [A4])
        :Chuyển về trang chủ;
      else (Không)
        :Hiển thị trang được bảo vệ;
      endif

      |Khách hàng (Customer)|
      if (Chọn Đăng xuất?) then (Đăng xuất [FR-11])
        |Frontend (Next.js)|
        :Xóa token và đặt lại trạng thái đăng nhập;
        :Chuyển về trang /login;
        stop
      else (Tiếp tục sử dụng)
        :Tiếp tục dùng các chức năng cần đăng nhập;
        stop
      endif
    else (Không còn [E7])
      |Backend (NestJS API)|
      :Trả về HTTP 401 Unauthorized;

      |Frontend (Next.js)|
      :Xóa token và đặt lại trạng thái đăng nhập;
    endif
  else (Sai chữ ký / Hết hạn [E5, E6])
    |Backend (NestJS API)|
    :Trả về HTTP 401 Unauthorized;

    |Frontend (Next.js)|
    :Xóa token và báo phiên đăng nhập đã hết hạn;
  endif
else (Chưa đăng nhập [A3])
  :Ghi nhớ trang đích (returnUrl);
endif

|Frontend (Next.js)|
:Chuyển hướng tới trang /login;

|Khách hàng (Customer)|
if (Đã có tài khoản?) then (Chưa có)
  :Chọn Đăng ký, nhập email, mật khẩu, họ tên (nếu có);
  :Bấm "Đăng ký";

  |Frontend (Next.js)|
  :Validate email, mật khẩu tối thiểu 8 ký tự;
  if (Dữ liệu hợp lệ?) then (Không hợp lệ [E1])
    :Báo lỗi theo từng trường, chặn gửi;
    stop
  else (Hợp lệ)
    :Khóa nút Đăng ký (chống gửi đúp);
    :Gửi POST /auth/register;
  endif

  |Backend (NestJS API)|
  :Validate RegisterDto (class-validator);
  if (DTO hợp lệ?) then (Không hợp lệ [E1])
    :Trả về HTTP 400 Bad Request;
    |Frontend (Next.js)|
    :Hiển thị lỗi theo từng trường, mở lại nút Đăng ký;
    stop
  else (Hợp lệ)
    |Cơ sở dữ liệu (PostgreSQL)|
    :Kiểm tra email đã tồn tại trong bảng users;
  endif

  if (Email đã tồn tại?) then (Đã tồn tại [E2])
    |Backend (NestJS API)|
    :Trả về HTTP 409 Conflict, không tạo bản ghi;
    |Frontend (Next.js)|
    :Báo email đã đăng ký và gợi ý chuyển sang Đăng nhập;
    stop
  else (Chưa tồn tại)
    |Backend (NestJS API)|
    :Băm mật khẩu bằng bcrypt (salt rounds 10–12);
    |Cơ sở dữ liệu (PostgreSQL)|
    :Tạo bản ghi users (email, passwordHash, fullName);
    note right
      UNIQUE(email) chặn đăng ký song song cùng email;
      khi vi phạm, backend trả HTTP 409 như E2.
    end note
    |Backend (NestJS API)|
    :Trả về HTTP 201 Created (không có mật khẩu, không có hash);
  endif

  |Frontend (Next.js)|
  :Thông báo đăng ký thành công;
  :Chuyển về form Đăng nhập;
else (Đã có tài khoản [A1])
endif

|Khách hàng (Customer)|
:Nhập email, mật khẩu và bấm "Đăng nhập";

|Frontend (Next.js)|
:Validate email và trường bắt buộc tại client;
if (Thông tin hợp lệ?) then (Không hợp lệ [E1])
  :Báo lỗi theo từng trường, chặn gửi;
  stop
else (Hợp lệ)
  :Khóa nút Đăng nhập (chống gửi đúp);
  :Gửi POST /auth/login;
endif

|Backend (NestJS API)|
:Validate LoginDto (class-validator);
if (DTO hợp lệ?) then (Không hợp lệ [E1])
  :Trả về HTTP 400 Bad Request;
  |Frontend (Next.js)|
  :Hiển thị lỗi và mở lại nút Đăng nhập;
  stop
else (Hợp lệ)
  |Cơ sở dữ liệu (PostgreSQL)|
  :Tìm người dùng theo email trong bảng users;
endif

if (Cơ sở dữ liệu phản hồi bình thường?) then (Lỗi hệ thống [E9])
  |Backend (NestJS API)|
  :Trả về HTTP 500 với thông báo chung;
  |Frontend (Next.js)|
  :Hiển thị lỗi hệ thống và cho phép thử lại;
  stop
else (Bình thường)
  |Backend (NestJS API)|
  :So sánh mật khẩu bằng bcrypt.compare với passwordHash;
endif

if (Người dùng tồn tại và mật khẩu khớp?) then (Sai thông tin [E3])
  :Trả về HTTP 401 với thông báo chung (không lộ email có tồn tại);
  |Frontend (Next.js)|
  :Hiển thị "Email hoặc mật khẩu không đúng";
  stop
else (Đúng)
  |Backend (NestJS API)|
  :Sinh JWT (sub, email, iat, exp) ký bằng JWT_SECRET;
  :Trả về HTTP 200 kèm accessToken và thông tin người dùng;
endif

|Frontend (Next.js)|
if (Lưu được token phía client?) then (Không [E8])
  :Thông báo không giữ được phiên đăng nhập;
  stop
else (Được)
  :Cập nhật trạng thái đăng nhập (auth state);
  :Chuyển về returnUrl hoặc trang chủ;
endif

|Khách hàng (Customer)|
:Thấy trạng thái đã đăng nhập (tên người dùng, nút Đăng xuất);
stop
@enduml
