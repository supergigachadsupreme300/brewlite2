@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle

actor Customer

rectangle "Order History" {
  usecase "UC-OH-01\nView Order History" as UC01
  usecase "UC-OH-02\nSearch Orders by ID" as UC02
  usecase "UC-OH-03\nFilter Orders by Status" as UC03
  usecase "UC-OH-04\nView Order Details" as UC04
  usecase "UC-OH-05\nRetry Loading Data" as UC05
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05

UC02 ..> UC01 : <<extend>>
UC03 ..> UC01 : <<extend>>
UC05 ..> UC01 : <<extend>>
UC05 ..> UC04 : <<extend>>

@enduml
