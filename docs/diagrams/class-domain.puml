@startuml
class Customer {
  +id: string
  +name: string
}

class Order {
  +id: string
  +status: string
  +total: decimal
  +createdAt: datetime
}

class OrderItem {
  +id: string
  +quantity: number
  +unitPrice: decimal
}

class Product {
  +id: string
  +name: string
  +price: decimal
}

class Payment {
  +id: string
  +amount: decimal
  +method: string
  +status: string
}

Customer "1" --> "0..*" Order
Order "1" --> "0..*" OrderItem
Product "1" --> "0..*" OrderItem
Order "1" --> "1" Payment
@enduml
