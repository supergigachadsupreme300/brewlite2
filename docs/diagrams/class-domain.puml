@startuml
class KhachHang {
  +id: string
  +ten: string
}

class DonDatHang {
  +id: string
  +trangThai: string
  +tongTien: decimal
  +ngayTao: datetime
}

class ChiTietDonHang {
  +id: string
  +soLuong: number
  +giaTien: decimal
}

class SanPham {
  +id: string
  +ten: string
  +gia: decimal
}

class ThanhToan {
  +id: string
  +soTien: decimal
  +phuongThuc: string
  +trangThai: string
}

KhachHang "1" --> "0..*" DonDatHang
DonDatHang "1" --> "0..*" ChiTietDonHang
SanPham "1" --> "0..*" ChiTietDonHang
DonDatHang "1" --> "1" ThanhToan
@enduml
