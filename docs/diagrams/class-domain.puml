@startuml class-domain
title Class diagram mức domain – BrewLite (User, Product, Cart, Order, OrderItem, Payment, Promotion, LoyaltyTransaction, Auth)

skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #444444
skinparam NoteBackgroundColor #FFFFE0
skinparam NoteBorderColor #B8860B
hide empty methods

enum Role <<enumeration>> {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum OrderStatus <<enumeration>> {
  PENDING_PAYMENT
  PAID
  CANCELLED
  PENDING
  PROCESSING
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
}

enum PaymentMethod <<enumeration>> {
  WALLET
  CARD
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus <<enumeration>> {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType <<enumeration>> {
  PERCENT
  FIXED_AMOUNT
}

enum LoyaltyTransactionType <<enumeration>> {
  EARN
  REDEEM
  ADJUST
}

enum ProductCategory <<enumeration>> {
  COFFEE
  TEA
  FREEZE
  PASTRY
  OTHER
}

class User {
  +id : UUID
  +email : String {unique}
  +passwordHash : String
  +fullName : String
  +phone : String
  +role : Role
  +loyaltyBalance : Integer
  +createdAt : DateTime
  +updatedAt : DateTime
  +lastLoginAt : DateTime [0..1]
}

class Product {
  +id : UUID
  +name : String
  +description : String
  +price : Decimal
  +stockQuantity : Integer
  +isAvailable : Boolean
  +imageUrl : String
  +category : ProductCategory
  +createdAt : DateTime
  +updatedAt : DateTime
  +checkAvailability(quantity : Integer) : Boolean
  +hasSufficientStock(quantity : Integer) : Boolean
  +decrementStock(quantity : Integer) : void
}

class ProductOption <<value object>> {
  +size : String
  +sugarLevel : String
  +iceLevel : String
  +extraToppings : String[]
}

class Cart {
  +id : UUID
  +clientId : String
  +createdAt : DateTime
  +updatedAt : DateTime
  +getTotalItems() : Integer
  +getTotalPrice() : Decimal
}

class CartItem {
  +id : UUID
  +cartId : UUID
  +productId : UUID
  +quantity : Integer
  +size : String
  +toppings : String
  +createdAt : DateTime
  +updatedAt : DateTime
  +getLineTotal() : Decimal
}

class Order {
  +id : UUID
  +status : OrderStatus
  +subtotal : Decimal
  +discountAmount : Decimal
  +totalAmount : Decimal
  +customerName : String
  +customerPhone : String
  +pickupType : String
  +tableNumber : String
  +note : String
  +paymentMethod : PaymentMethod
  +createdAt : DateTime
  +updatedAt : DateTime
  +paidAt : DateTime [0..1]
  +calculateTotal() : Decimal
}

class OrderItem {
  +id : UUID
  +quantity : Integer
  +unitPrice : Decimal
  +lineTotal : Decimal
  +size : String
  +toppings : String
}

class Payment {
  +id : UUID
  +amount : Decimal
  +method : PaymentMethod
  +status : PaymentStatus
  +idempotencyKey : String {unique}
  +transactionRef : String [0..1]
  +transactionCode : String
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Promotion {
  +id : UUID
  +code : String {unique}
  +description : String
  +discountType : DiscountType
  +discountValue : Decimal
  +minOrderAmount : Decimal
  +startsAt : DateTime
  +endsAt : DateTime
  +isActive : Boolean
}

class LoyaltyTransaction {
  +id : UUID
  +type : LoyaltyTransactionType
  +points : Integer
  +balanceAfter : Integer
  +createdAt : DateTime
}

class JwtPayload <<value object>> {
  +sub : String
  +email : String
  +iat : Integer
  +exp : Integer
}

User "1" -- "0..*" Order : đặt >
Order "1" *-- "1..*" OrderItem : gồm >
OrderItem "0..*" --> "1" Product : tham chiếu >
Order "1" -- "0..*" Payment : được thanh toán bởi >
Promotion "0..1" <-- "0..*" Order : áp dụng
User "1" -- "0..*" LoyaltyTransaction : tích lũy / sử dụng >
Order "0..1" <-- "0..*" LoyaltyTransaction : phát sinh từ
User "1" -- "0..1" Cart : sở hữu >
Cart "1" *-- "0..*" CartItem : chứa >
Product "1" -- "0..*" CartItem : được chọn >
Product "1" *-- "0..*" ProductOption : hỗ trợ >
User ..> JwtPayload : sinh ra khi đăng nhập
User ..> Role
Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Promotion ..> DiscountType
LoyaltyTransaction ..> LoyaltyTransactionType
Product ..> ProductCategory

note bottom of Payment
  Ràng buộc nghiệp vụ:
  - amount luôn lấy từ Order.totalAmount (backend quyết định).
  - Mỗi Order có tối đa 1 Payment ở trạng thái SUCCESS.
  - Một Order có thể có nhiều Payment: các lần FAILED/PENDING trước đó (khác idempotencyKey).
  - Không lưu số thẻ, CVV hay mật khẩu thanh toán.
end note

note bottom of Order
  Order.status = PAID chỉ khi Payment SUCCESS.
  Payment FAILED không đổi Order sang PAID.
end note

@enduml